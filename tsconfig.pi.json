{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"exactOptionalPropertyTypes": false,
		"erasableSyntaxOnly": true,
		"types": ["node"]
	},
	"include": ["pi/extensions/**/*.ts", ".pi/extensions/**/*.ts"],
	"exclude": ["node_modules", ".botlake/node_modules"]
}
