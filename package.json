{
	"name": "@codethread/agents",
	"version": "0.1.0",
	"description": "codethread's Pi extensions, agents, prompts, and themes",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-prompt",
		"pi-theme",
		"pi-agent"
	],
	"files": [
		"pies",
		"agents",
		"pi/extensions",
		"pi/themes",
		"plugins"
	],
	"bin": {
		"pi": "./pies/pi-shim.ts",
		"pies": "./pies/cli.ts"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"pies": "node --experimental-strip-types ./pies/cli.ts",
		"pies:daemon": "node --experimental-strip-types ./pies/daemon.ts",
		"link:pi": "mkdir -p \"$HOME/.local/bin\" && ln -sfn \"$PWD/pies/pi-shim.ts\" \"$HOME/.local/bin/pi\" && ln -sfn \"$PWD/pies/cli.ts\" \"$HOME/.local/bin/pies\"",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format",
		"verify": "pnpm check",
		"prepare": "husky"
	},
	"pi": {
		"extensions": [
			"./pi/extensions/system-prompt/index.ts",
			"./pi/extensions/provider-override/index.ts",
			"./pi/extensions/dialogue-capture/index.ts",
			"./pi/extensions/tools",
			"./pi/extensions/ui",
			"./pi/extensions/messaging",
			"./pi/extensions/cli"
		],
		"prompts": [
			"./plugins/coding/commands",
			"./plugins/harness/commands"
		],
		"skills": [
			"./plugins/writing/skills",
			"./plugins/coding/skills",
			"./plugins/harness/skills"
		],
		"themes": [
			"./pi/themes"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*",
		"@sinclair/typebox": "*"
	},
	"devDependencies": {
		"@codethread/pi-agent-core-test": "npm:@earendil-works/pi-agent-core@0.74.0",
		"@codethread/pi-ai-test": "npm:@earendil-works/pi-ai@0.74.0",
		"@codethread/pi-coding-agent-test": "npm:@earendil-works/pi-coding-agent@0.74.0",
		"@codethread/pi-tui-test": "npm:@earendil-works/pi-tui@0.74.0",
		"@earendil-works/pi-agent-core": "0.84.4",
		"@earendil-works/pi-tui": "0.84.4",
		"@eslint/js": "^9.25.1",
		"@gaodes/pi-test-harness": "^1.0.3",
		"@types/minimist": "^1.2.5",
		"@types/ms": "^2.1.0",
		"@types/node": "^24.0.0",
		"@types/nunjucks": "^3.2.6",
		"@types/which": "^3.0.4",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"prettier": "^3.5.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.30.1",
		"vitest": "^4.1.3"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@mozilla/readability": "^0.6.0",
		"@types/turndown": "^5.0.6",
		"linkedom": "^0.18.12",
		"minimist": "^1.2.8",
		"ms": "^2.1.3",
		"nunjucks": "^3.2.4",
		"turndown": "^7.2.4",
		"which": "6.0.1",
		"zod": "^4.3.6"
	},
	"volta": {
		"node": "24.15.0",
		"pnpm": "11.5.2"
	}
}
