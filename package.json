{
	"name": "@codethread/agents",
	"version": "0.1.0",
	"description": "codethread's Pi extensions, prompts, and themes",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-prompt",
		"pi-theme"
	],
	"files": [
		"pi/extensions",
		"pi/themes",
		"skillbox",
		"plugins",
		"pnpm-lock.yaml"
	],
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format",
		"verify": "pnpm check",
		"prepare": "husky"
	},
	"pi": {
		"extensions": [
			"./pi/extensions/system-prompt/index.ts",
			"./pi/extensions/provider-override/index.ts",
			"./pi/extensions/dialogue-capture/index.ts",
			"./pi/extensions/tools",
			"./pi/extensions/ui",
			"./pi/extensions/messaging",
			"./pi/extensions/cli"
		],
		"themes": [
			"./pi/themes"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@sinclair/typebox": "*"
	},
	"devDependencies": {
		"@codethread/skillbox": "^0.2.1",
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@eslint/js": "^9.39.5",
		"@gaodes/pi-test-harness": "^1.0.3",
		"@types/ms": "^2.1.0",
		"@types/node": "^24.19.2",
		"@types/nunjucks": "^3.2.6",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"@types/turndown": "^5.0.6",
		"linkedom": "^0.18.15",
		"ms": "^2.1.3",
		"nunjucks": "^3.2.4",
		"turndown": "^7.2.5",
		"zod": "^4.6.7"
	},
	"volta": {
		"node": "24.15.0",
		"pnpm": "11.5.2"
	}
}
