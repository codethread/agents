#!/usr/bin/env sh
set -e

# beeswax:begin tracker-validation v2
"$(git rev-parse --git-path beeswax/cli)" system hooks validate || exit $?
# beeswax:end tracker-validation

# The permanent tracker has no application dependencies. Validation above still runs.
if "$(git rev-parse --git-path beeswax/cli)" system hooks is-tracker-snapshot; then
	exit 0
fi

pnpm lint-staged
pnpm typecheck
pnpm exec vitest run --changed
