{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/.codex-plugin/hooks/capture.sh\""
					},
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/.codex-plugin/hooks/identity.sh\"",
						"timeout": 18,
						"statusMessage": "Binding Millstrand identity",
						"additionalContextLimit": 4096
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/.codex-plugin/hooks/identity.sh\"",
						"timeout": 18,
						"statusMessage": "Binding Millstrand child identity",
						"additionalContextLimit": 4096
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/.codex-plugin/hooks/capture.sh\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/.codex-plugin/hooks/capture.sh\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${PLUGIN_ROOT}/.codex-plugin/hooks/capture.sh\""
					}
				]
			}
		]
	}
}
